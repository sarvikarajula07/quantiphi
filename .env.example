# Vibe AI Configuration
# Provide at least ONE API key below (Gemini is free to start at https://aistudio.google.com/)

# Option 1: Google Gemini API (Recommended & Free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: OpenAI API (Alternative)
# OPENAI_API_KEY=your_openai_api_key_here

# Server Port (optional, defaults to 3001 if running standalone server)
PORT=3001
